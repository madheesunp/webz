// Flow — knowledge-graph social platform
// Prisma 8 (Prisma Next) contract. Edit this file, then run:
//   npx prisma contract emit && npx prisma db update

model User {
  id        String            @id @default(cuid(2))
  email     String            @unique
  name      String?
  image     String?
  webs      Web[]
  comments  Comment[]
  likes     Like[]
  createdAt TimestamptzString @default(now())
}

model Web {
  id          String   @id @default(cuid(2))
  title       String
  description String?

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // Graph data stored as JSON (jsonb)
  nodes Json // [{ id, x, y, label, description, imageUrl, color, radius }]
  edges Json // [{ source, target, label? }]

  // Social features
  public   Boolean   @default(false)
  likes    Like[]
  comments Comment[]
  views    Int       @default(0)

  // Metadata for search. Scalar lists aren't supported in Prisma 8,
  // so tags are a JSON array of strings, e.g. ["techno", "detroit"].
  // Nullable (no default) to avoid a mis-encoded JSON default; set it
  // explicitly in app code (e.g. tags: []) when creating a Web.
  tags     Json?
  template Boolean @default(false)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([authorId])
  @@index([public])
}

model Like {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  web    Web    @relation(fields: [webId], references: [id], onDelete: Cascade)
  webId  String

  @@unique([userId, webId])
}

model Comment {
  id   String @id @default(cuid(2))
  text String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  web      Web    @relation(fields: [webId], references: [id], onDelete: Cascade)
  webId    String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
